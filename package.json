{
  "name": "graphsync",
  "private": true,
  "version": "1.0.0",
  "description": "Lightweight P2P folder synchronization desktop client",
  "author": "Hardik Kanajariya <https://hardikkanajariya.in>",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:website": "pnpm --filter graphsync-website dev",
    "build": "tsc && vite build",
    "build:website": "pnpm --filter graphsync-website build",
    "preview": "vite preview",
    "preview:website": "pnpm --filter graphsync-website preview",
    "tauri": "tauri",
    "check": "pnpm build && pnpm build:website"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
